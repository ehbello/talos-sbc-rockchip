Support driving the SPI chip-select from a GPIO in the rockchip SPI driver.

The driver only drove the native chip-select via the SER register. On some
boards the rk3399 native CS is claimed by hardware and can't be released, so
the device must be selected from a GPIO (as Linux supports via cs-gpios). Add
optional cs-gpios support (active-low, per the SPI CS convention).

--- a/drivers/spi/rk_spi.c	2026-08-10 14:14:40.199755372 +0100
+++ b/drivers/spi/rk_spi.c	2026-08-10 14:14:40.325389146 +0100
@@ -23,6 +23,7 @@
 #include <asm/arch-rockchip/clock.h>
 #include <asm/arch-rockchip/periph.h>
 #include <dm/pinctrl.h>
+#include <asm/gpio.h>
 #include "rk_spi.h"
 
 /* Change to 1 to output registers at the start of each transaction */
@@ -34,6 +35,9 @@
  */
 #define ROCKCHIP_SPI_MAX_TRANLEN		0xffff
 
+/* Rockchip SPI controllers expose up to two native chip selects. */
+#define ROCKCHIP_SPI_MAX_CS		2
+
 struct rockchip_spi_params {
 	/* RXFIFO overruns and TXFIFO underruns stop the master clock */
 	bool master_manages_fifo;
@@ -47,6 +51,7 @@
 	uintptr_t base;
 	uint deactivate_delay_us;	/* Delay to wait after deactivate */
 	uint activate_delay_us;		/* Delay to wait after activate */
+	struct gpio_desc cs_gpios[ROCKCHIP_SPI_MAX_CS];
 };
 
 struct rockchip_spi_priv {
@@ -152,6 +157,8 @@
 	}
 
 	debug("activate cs%u\n", cs);
+	if (cs < ROCKCHIP_SPI_MAX_CS && dm_gpio_is_valid(&plat->cs_gpios[cs]))
+		dm_gpio_set_value(&plat->cs_gpios[cs], 1);
 	writel(1 << cs, &regs->ser);
 	if (plat->activate_delay_us)
 		udelay(plat->activate_delay_us);
@@ -166,6 +173,8 @@
 
 	debug("deactivate cs%u\n", cs);
 	writel(0, &regs->ser);
+	if (cs < ROCKCHIP_SPI_MAX_CS && dm_gpio_is_valid(&plat->cs_gpios[cs]))
+		dm_gpio_set_value(&plat->cs_gpios[cs], 0);
 
 	/* Remember time of this transaction so we can honour the bus delay */
 	if (plat->deactivate_delay_us)
@@ -216,6 +225,26 @@
 		debug("%s: base=%x, max-frequency=%d, deactivate_delay=%d\n",
 		      __func__, (uint)plat->base, plat->frequency,
 		      plat->deactivate_delay_us);
+
+		if (CONFIG_IS_ENABLED(DM_GPIO)) {
+			int i;
+
+			/*
+			 * Optional cs-gpios: the rk3399 native chip-select is
+			 * not usable on some boards, so allow driving CS from a
+			 * GPIO (as Linux does). Treated as active-low, matching
+			 * the SPI CS convention.
+			 */
+			for (i = 0; i < ROCKCHIP_SPI_MAX_CS; i++) {
+				ret = gpio_request_by_name(bus, "cs-gpios", i,
+							   &plat->cs_gpios[i],
+							   GPIOD_IS_OUT |
+							   GPIOD_ACTIVE_LOW);
+				if (ret && ret != -ENOENT)
+					debug("%s: cs-gpios[%d]: %d\n",
+					      __func__, i, ret);
+			}
+		}
 	}
 
 	return 0;
